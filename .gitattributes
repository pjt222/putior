# Store every text file with LF line endings; git detects binary files itself
* text=auto eol=lf

# Enforce LF line endings for R source files
*.R text eol=lf
*.Rmd text eol=lf
*.Rd text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets: never convert
*.png binary
*.gif binary
*.ico binary
*.pdf binary
