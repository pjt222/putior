  -d '{"input": [{"role": "user", "parts": [{"content": "scan ./R/"}]}]}'

# With a token
curl -X POST http://localhost:8080/runs \\
  -H "Authorization: Bearer $PUTIOR_ACP_TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{"input": [{"role": "user", "parts": [{"content": "scan ./R/"}]}]}'
